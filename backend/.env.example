YOUTUBE_API_KEY=
FIND_THE_REST_API_KEY=change-me-for-beta
ENABLE_LOCAL_TRANSCRIPTION=0

# Optional licensed open-web/cross-platform discovery provider
BRAVE_SEARCH_API_KEY=

# Cost/latency guard for cross-platform web queries (1-9)
FIND_THE_REST_MAX_SEARCHES=7

# Optional provider-neutral reverse-image gateway.
# POST multipart field `media`; expected JSON: {"results":[{"url","title","snippet","score","creator","platform"}]}
FINDREST_REVERSE_IMAGE_ENDPOINT=
FINDREST_REVERSE_IMAGE_KEY=
# Optional comma-separated allowlist for the configured reverse-image gateway hostname.
# When set, the gateway must be HTTPS and match one of these hosts exactly.
FINDREST_REVERSE_IMAGE_ALLOWED_HOSTS=
# Maximum JSON response body accepted from the gateway (64KB–8MB, default 2MB).
FINDREST_REVERSE_IMAGE_MAX_RESPONSE_BYTES=2097152

# Short-lived in-memory result cache. Raw media is never cached.
FINDREST_CACHE_TTL_SECONDS=900
FINDREST_CACHE_MAX_ITEMS=256

# Optional feedback JSONL destination. Feedback stores no raw media/transcripts/OCR text.
FINDREST_FEEDBACK_PATH=/tmp/findrest-feedback.jsonl

# Lightweight persistent continuation-watch store.
# Stores only source URL, watch state, and latest result reference—not raw media.
FINDREST_WATCH_PATH=/tmp/findrest-watches.json

FINDREST_PUSH_STORE_PATH=/tmp/findrest-push.json
FINDREST_PUSH_ENDPOINT=
FINDREST_PUSH_KEY=
FINDREST_WATCH_DB_PATH=/tmp/findrest-watches.sqlite3

# Privacy-safe beta diagnostics (no raw URLs/media/transcripts/OCR)
FINDREST_DIAGNOSTICS_PATH=/tmp/findrest-diagnostics.jsonl
FINDREST_DIAGNOSTICS_MAX_EVENTS=1000

# Optional licensed/permitted candidate-media gateway.
# POST JSON: {"candidate_url":"https://..."}; response must be video bytes.
# Find the Rest never directly downloads arbitrary candidate URLs through this path.
FINDREST_CANDIDATE_MEDIA_ENDPOINT=
FINDREST_CANDIDATE_MEDIA_KEY=
# Optional comma-separated exact hostname allowlist for the licensed/permitted gateway.
FINDREST_CANDIDATE_MEDIA_ALLOWED_HOSTS=
FINDREST_CANDIDATE_MEDIA_MAX_BYTES=62914560

# Scheduler runner. Render uses private host/port wiring automatically.
# Other hosts can set an explicit backend base URL instead.
FINDREST_SCHEDULER_BASE_URL=
FINDREST_SCHEDULER_HOSTPORT=
FINDREST_SCHEDULER_TIMEOUT_SECONDS=120

# Privacy-safe beta feedback cases used to spot recurring regression patterns.
# Stores only coarse labels plus short hashes; no raw URLs/media/transcripts/OCR/text.
FINDREST_FEEDBACK_CASES_PATH=/tmp/findrest-feedback-cases.jsonl
FINDREST_FEEDBACK_CASES_MAX=2000

# Automatic verification-aware reranking cost guard (1-3, default 2).
FINDREST_VERIFICATION_RERANK_MAX_CANDIDATES=2

# Optional provider-neutral semantic visual-clue gateway.
# POST multipart field `media`; expected JSON keys: objects, logos, scenes, clothing.
# HTTPS is required. Media is request-scoped.
FINDREST_VISION_CLUES_ENDPOINT=
FINDREST_VISION_CLUES_KEY=
# Optional exact comma-separated hostname allowlist for the visual-clue gateway.
FINDREST_VISION_CLUES_ALLOWED_HOSTS=
# Maximum JSON response accepted from the provider (64KB-8MB, default 2MB).
FINDREST_VISION_CLUES_MAX_RESPONSE_BYTES=2097152

# Browser access is disabled by default. If a web client is added, list exact allowed origins.
FINDREST_CORS_ORIGINS=
# Production Host-header allowlist, e.g. find-the-rest-api.onrender.com
FINDREST_TRUSTED_HOSTS=
